{
  "name": "dsh-process-pin",
  "version": "0.1.7-local.1",
  "description": "Pin the expanded turn-process control and disclosure-row headers to the top of the DSH conversation while you read them (Excel freeze-panes style), with a two-level hierarchy and a collapse-all entry. 让「轮次过程控件 / 思维链标题」吸顶并分级叠放的 DSH Web 插件。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <4",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <0.1.8"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "sticky",
    "freeze-pane",
    "turn-process",
    "thinking",
    "disclosure"
  ],
  "license": "MIT"
}
